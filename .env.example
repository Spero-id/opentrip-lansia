# === Database (Neon PostgreSQL) ===
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# === Better Auth ===
# BETTER_AUTH_SECRET: generate dengan `openssl rand -base64 32` — WAJIB beda dari dev
# BETTER_AUTH_URL & NEXT_PUBLIC_BETTER_AUTH_URL: HARUS domain produksi, bukan localhost
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://example.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://example.com

# === Google OAuth (opsional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === SMTP (notifikasi email) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=

# === Frontend ===
BASE_URL=https://example.com
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
NEXT_PUBLIC_WHATSAPP_MESSAGE=Halo

# === Midtrans (jika Snap dipakai) ===
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# === Checklist sebelum deploy ===
# [ ] Ganti password seed admin@otl.id (lihat src/db/seed.ts) — kredensial default: admin
# [ ] Jalankan migrasi drizzle/*.sql manual di server (tidak ada runner otomatis di build)
# [ ] npm audit fix  (next 16.2.11 → 16.3.6, ada advisory critical)
# [ ] Pastikan volume/backup untuk folder ./uploads (file ditulis ke local FS)
